# Top-level (human-edited) runtime dependencies for the CoGA backend.
#
# This file expresses INTENT (the direct dependencies and their version
# constraints). The fully-pinned, hash-locked install set is the compiled
# `requirements.txt`, generated from this file with pip-tools against
# Python 3.12 (the deployed/CI runtime). Do not edit requirements.txt by hand.
#
# Regenerate after changing this file:
#     ./scripts/compile-requirements.sh
#
# Why pinned + hashed: CoGA is an in-house IVD (IVDR Art. 5(5)); a clinical
# build must be byte-for-byte reproducible and supply-chain-verifiable
# (technical file TF-08 SOUP register, TF-13 cybersecurity).

fastapi==0.162.4
# Starlette is pinned explicitly: it is the ASGI core under the collection-root redirect
# normalisation in app/main.py, which must keep /api/* from 307-redirecting to the internal
# backend host. Re-verify that before moving the pin.
starlette==1.10.0
uvicorn[standard]==0.54.0
sqlalchemy>=2.1.8
greenlet>=3.5.6
asyncpg
# Postgres schema migrations: the ledger and the revisions in backend/db/migrations,
# run by app/core/postgres_migrations.py. It brings Mako (the revision template) and
# MarkupSafe.
alembic==1.20.1
clickhouse-connect[async]>=1.12.0,<2
pydantic[email]>=2.14.3
pydantic-settings>=2.16.2
# PyJWT (not python-jose): python-jose pulls the `ecdsa` package, which has no
# fix for the Minerva P-256 timing attack (GHSA-wj6h-64fc-37mp). We only use
# HS256 + RS256, never ECDSA, and PyJWT verifies both without depending on ecdsa.
PyJWT[crypto]
# Password hashing, called directly: passlib is unmaintained and would hold bcrypt at 3.2.0.
bcrypt>=5.0.0,<6
python-multipart
# The Prometheus exposition behind GET /metrics (operations monitoring, outside the
# clinical path; app/services/operational_metrics.py). It has no dependencies of its own.
prometheus-client==0.26.0
# Reads the .env file (config.py passes env_file to pydantic-settings, which calls it).
python-dotenv
httpx
# Fixed-reference exploratory ancestry PCA (also already required by pandas).
numpy==2.5.4
pysam
# Reading the bigWig signal tracks HiFiCNV ships in a long-read family package
# (read depth, minor allele fraction) -- see app/services/family_package_bigwig.py.
pyBigWig
PyYAML

# Clinical CNV knowledgebase build script (scripts/clinical_cnv_knowledgebase.py),
# invoked as a subprocess by the admin "rebuild knowledgebase" action.
pandas
requests
beautifulsoup4

intervaltree
tqdm

# Cloud SQL Python Connector for verify-full-grade TLS (mTLS) to Postgres over
# private IP (POSTGRES_USE_CLOUD_SQL_CONNECTOR=true). See app/core/postgres.py.
cloud-sql-python-connector[asyncpg]
