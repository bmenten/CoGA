# =============================================================================
# CoGA prerequisites — LIVES IN THE CENTRAL INFRA REPO, NOT THE CoGA APP REPO
# =============================================================================
#
# Lift this file into the central/landing-zone repo, remove the `.example` suffix, and
# apply it BEFORE the CoGA repo's terraform apply. It provisions everything that needs
# project-IAM-admin or service-account-admin rights — kept out of the CoGA pipeline so
# that pipeline cannot grant itself privileges.
#
# Adjust provider/backend/naming to your landing-zone conventions.

variable "project_id" {
  description = "CoGA runtime project id."
  type        = string
}

variable "cmek_key_self_link" {
  description = "The CMEK crypto key protecting CoGA (projects/../locations/../keyRings/../cryptoKeys/..)."
  type        = string
}

locals {
  name_prefix = "coga"
}

data "google_project" "coga" {
  project_id = var.project_id
}

# GCS service agent (needs CMEK encrypt/decrypt for the CoGA buckets).
data "google_storage_project_service_account" "gcs" {
  project = var.project_id
}

# ---- APIs -------------------------------------------------------------------

resource "google_project_service" "coga" {
  for_each = toset([
    "compute.googleapis.com",
    "run.googleapis.com",
    "sqladmin.googleapis.com",
    "servicenetworking.googleapis.com",
    "vpcaccess.googleapis.com",
    "secretmanager.googleapis.com",
    "cloudkms.googleapis.com",
    "storage.googleapis.com",
    "artifactregistry.googleapis.com",
    "iam.googleapis.com",
    "iamcredentials.googleapis.com", # keyless V4 signed URLs (SignBlob)
    "logging.googleapis.com",
    "monitoring.googleapis.com",
    "certificatemanager.googleapis.com",
    "cloudresourcemanager.googleapis.com",
    "dns.googleapis.com", # private Google API zones for the ClickHouse egress lockdown
  ])
  project                    = var.project_id
  service                    = each.value
  disable_on_destroy         = false
  disable_dependent_services = false
}

# ---- Runtime service accounts ----------------------------------------------

resource "google_service_account" "backend" {
  project      = var.project_id
  account_id   = "${local.name_prefix}-backend-run"
  display_name = "CoGA backend (Cloud Run)"
}

resource "google_service_account" "frontend" {
  project      = var.project_id
  account_id   = "${local.name_prefix}-frontend-run"
  display_name = "CoGA frontend (Cloud Run)"
}

resource "google_service_account" "clickhouse_vm" {
  project      = var.project_id
  account_id   = "${local.name_prefix}-clickhouse-vm"
  display_name = "CoGA ClickHouse VM"
}

# Runs the db-migrate Cloud Run job as the Postgres owner (CoGA terraform/migrate.tf,
# db_runtime_role = "coga_app"). Separate from the backend account so the API never holds
# the owner's password. The CoGA config grants it the secrets it reads.
resource "google_service_account" "db_migrate" {
  project      = var.project_id
  account_id   = "${local.name_prefix}-db-migrate"
  display_name = "CoGA schema migration (Cloud Run job)"
}

# ---- Project-level IAM grants (least privilege) -----------------------------

# Backend: Cloud SQL client, logs, metrics.
resource "google_project_iam_member" "backend_sql_client" {
  project = var.project_id
  role    = "roles/cloudsql.client"
  member  = "serviceAccount:${google_service_account.backend.email}"
}

resource "google_project_iam_member" "backend_log_writer" {
  project = var.project_id
  role    = "roles/logging.logWriter"
  member  = "serviceAccount:${google_service_account.backend.email}"
}

resource "google_project_iam_member" "backend_metric_writer" {
  project = var.project_id
  role    = "roles/monitoring.metricWriter"
  member  = "serviceAccount:${google_service_account.backend.email}"
}

# Backend signs blobs as itself — V4 signed URLs to GCS without a JSON key.
resource "google_service_account_iam_member" "backend_token_creator" {
  service_account_id = google_service_account.backend.name
  role               = "roles/iam.serviceAccountTokenCreator"
  member             = "serviceAccount:${google_service_account.backend.email}"
}

# Schema migration job: Cloud SQL client only (logs from a Cloud Run job need no role).
resource "google_project_iam_member" "db_migrate_sql_client" {
  project = var.project_id
  role    = "roles/cloudsql.client"
  member  = "serviceAccount:${google_service_account.db_migrate.email}"
}

# The CoGA deploy pipeline's service account must be able to deploy the job as this
# account and run it: roles/iam.serviceAccountUser on google_service_account.db_migrate,
# like the actAs grants on the other runtime accounts (rollout-checklist.md, Part C), and a
# Cloud Run role that includes run.jobs.run (roles/run.developer or roles/run.admin).

# Frontend: logs only.
resource "google_project_iam_member" "frontend_log_writer" {
  project = var.project_id
  role    = "roles/logging.logWriter"
  member  = "serviceAccount:${google_service_account.frontend.email}"
}

# ClickHouse VM: logs + metrics.
resource "google_project_iam_member" "clickhouse_log_writer" {
  project = var.project_id
  role    = "roles/logging.logWriter"
  member  = "serviceAccount:${google_service_account.clickhouse_vm.email}"
}

resource "google_project_iam_member" "clickhouse_metric_writer" {
  project = var.project_id
  role    = "roles/monitoring.metricWriter"
  member  = "serviceAccount:${google_service_account.clickhouse_vm.email}"
}

# ClickHouse VM: pull its image from Artifact Registry, required once the egress lockdown
# (clickhouse_restrict_egress) cuts Docker Hub off. Grant it on the repository holding the
# mirrored image, which may live in the shared registry project, e.g.:
#
# resource "google_artifact_registry_repository_iam_member" "clickhouse_image_reader" {
#   project    = "<registry project>"
#   location   = "europe-west1"
#   repository = "<repository>"
#   role       = "roles/artifactregistry.reader"
#   member     = "serviceAccount:${google_service_account.clickhouse_vm.email}"
# }

# ---- CMEK key grants to the Google service agents --------------------------

resource "google_kms_crypto_key_iam_member" "sql" {
  crypto_key_id = var.cmek_key_self_link
  role          = "roles/cloudkms.cryptoKeyEncrypterDecrypter"
  member        = "serviceAccount:service-${data.google_project.coga.number}@gcp-sa-cloud-sql.iam.gserviceaccount.com"
}

resource "google_kms_crypto_key_iam_member" "compute" {
  crypto_key_id = var.cmek_key_self_link
  role          = "roles/cloudkms.cryptoKeyEncrypterDecrypter"
  member        = "serviceAccount:service-${data.google_project.coga.number}@compute-system.iam.gserviceaccount.com"
}

resource "google_kms_crypto_key_iam_member" "storage" {
  crypto_key_id = var.cmek_key_self_link
  role          = "roles/cloudkms.cryptoKeyEncrypterDecrypter"
  member        = "serviceAccount:${data.google_storage_project_service_account.gcs.email_address}"
}

# ---- S-4: project-wide byte-level PHI download audit ------------------------

resource "google_project_iam_audit_config" "storage_data_access" {
  project = var.project_id
  service = "storage.googleapis.com"

  audit_log_config {
    log_type = "DATA_READ"
  }
  audit_log_config {
    log_type = "DATA_WRITE"
  }
}
