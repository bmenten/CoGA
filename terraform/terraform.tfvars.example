# Copy to terraform.tfvars (gitignored) or pass via -var / CI. Image vars and
# passwords are supplied by CI; you typically only set the project-level values here.

project_id = "my-coga-project"
region     = "europe-west1"
zone       = "europe-west1-b"

app_domain = "coga.cmgg.be"

# Container images (CI sets these per build; example shown for manual applies). CI tags
# a main build `main-<12-character commit>` and a release build with its release tag.
backend_image  = "europe-west1-docker.pkg.dev/my-registry-project/coga/coga-backend:main-0123456789ab"
frontend_image = "europe-west1-docker.pkg.dev/my-registry-project/coga/coga-frontend:main-0123456789ab"

# CMEK: fully-qualified crypto key id, same region as the resources it protects.
# Encryption is mandatory (organization policy) — there is no on/off toggle; this is
# required. The key + its service-agent grants are provisioned in the central infra
# repo (see terraform/main-repo-reference/).
cmek_key_self_link = "projects/my-kms-project/locations/europe-west1/keyRings/coga/cryptoKeys/coga"

# Sizing (scale up for production).
db_tier                 = "db-custom-1-3840"
db_availability_type    = "ZONAL"
clickhouse_machine_type = "e2-standard-4"
clickhouse_data_disk_gb = 200

# Optional Azure AD / Entra institutional login.
azure_ad_tenant_id = ""
azure_ad_client_id = ""

# Who the alert policies email (monitoring.tf, docs/monitoring.md). Empty, incidents open in
# Cloud Monitoring but nobody is told.
# alert_notification_emails = ["coga-ops@your-institution.example"]
# The metrics collector beside the backend needs a version in coga-metrics-token (5.5).
# metrics_collection_enabled = true
# With allowed_ingress_cidrs set, allow the uptime checkers' ranges or turn the check off.
# uptime_check_enabled = true

# ---- Go-live hardening (each off by default; switch on as a change-controlled deploy) ----
# In CI these belong in the gcp-deploy environment's COGA_TFVARS variable.

# Only institutional networks reach the app (Cloud Armor denies every other source).
# Documentation ranges shown; use the UGent / UZ Gent / VPN egress ranges IT confirms.
# allowed_ingress_cidrs = ["192.0.2.0/24", "198.51.100.0/24"]

# Block OWASP CRS matches instead of only logging them, once the WAF logs show no false
# positives against normal use (docs/deployment-gcp.md, section 12.7).
# cloud_armor_waf_enforce = true

# Run the API as the restricted role coga_app (docs/db-runtime-role-runbook.md, "Google
# Cloud"): needs a version in coga-postgres-app-password and the coga-db-migrate account.
# db_runtime_role = "coga_app"

# ClickHouse VM may reach only Google APIs (egress.tf). Needs the image in Artifact Registry.
# clickhouse_restrict_egress = true
# clickhouse_image           = "europe-west1-docker.pkg.dev/my-registry-project/coga/clickhouse-server:26.8@sha256:<digest>"
