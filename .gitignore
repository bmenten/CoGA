# OS files
.DS_Store
Thumbs.db

# Environment variables (.env.example is the tracked template)
.env
*.env
.env.*
!.env.example

# Claude Code session state and worktrees
.claude/

# Python
__pycache__/
*.py[cod]
.Python
env/
venv/
.venv/
build/
dist/
.eggs/
*.egg-info/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.cache/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Playwright (browser e2e) — per-run reports/artifacts, not committed
frontend/playwright-report/
frontend/test-results/
frontend/playwright/.cache/

# Editor directories
.vscode/
.idea/

# Generated SBOMs — produced on demand (scripts/generate-sbom.sh) and per build
# in CI as retained artifacts; not committed (each run has a fresh serialNumber/
# timestamp). See sbom/README.md.
/sbom/*.cdx.json

# Data files
/data/families/
/data/family-packages/
/data/imports/
/data/**/*.cram
/data/**/*.cram.crai
/data/**/*.bam
/data/**/*.bam.bai
/data/**/*.bcf
/data/**/*.bcf.csi
/data/**/*.fastq
/data/**/*.fastq.gz
/data/**/*.vcf.gz
/data/**/*.vcf.gz.tbi
/data/**/*.vcf.gz.csi
/data/**/*.vcf
/data/**/*.bed
/data/**/*.npz
/data/**/*.tsv
/data/**/*.tsv.gz
/data/ref-data/dbNSFP*

# Coverage reports and the per-job data files CI combines
frontend/coverage/
coverage.json
coverage-*.data
coverage-combined.json

# Vite / Vitest caches
frontend/.vite/

# Terraform / OpenTofu working files
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfvars
crash.log
crash.*.log
tfplan
# Provider lock is generated by CI's `terraform init`; not committing the locally
# generated (OpenTofu) lock to avoid registry-hash mismatches.
.terraform.lock.hcl
