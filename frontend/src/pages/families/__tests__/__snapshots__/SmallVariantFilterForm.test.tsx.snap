exports[`renders the Global Small Variant Explorer form as recorded 1`] = `
"<form class="space-y-4 variant-search-workspace"><div class="variant-search-header"><div class="variant-search-meta"><div class="variant-search-toolbar"><button type="submit" class="form-button">Apply filters</button><button type="button" class="button-secondary">Clear all filters</button></div></div></div><section class="variant-search-section"><div class="variant-filter-dropdown-grid"><details class="variant-filter-dropdown"><summary class="variant-filter-dropdown-summary"><span class="variant-filter-dropdown-summary-copy"><span class="variant-filter-dropdown-title">Pathogenicity</span><span class="variant-filter-dropdown-meta">1 active</span></span><span class="variant-filter-dropdown-summary-controls" role="presentation"><label class="variant-summary-select-field"><span>Quick</span><select aria-label="Quick pathogenicity"><option value="all">All</option><option value="path_likely_path">P/LP</option><option value="not_benign">Not benign</option><option value="custom">Custom</option></select></label></span><span class="variant-filter-dropdown-caret" aria-hidden="true">▾</span></summary><div class="variant-filter-dropdown-content"><p class="variant-annotation-impact-title">ClinVar status</p><div class="variant-checkbox-grid variant-checkbox-grid--small"><label class="analysis-checkbox variant-compact-checkbox"><input type="checkbox" checked="">Pathogenic</label><label class="analysis-checkbox variant-compact-checkbox"><input type="checkbox">Likely pathogenic</label><label class="analysis-checkbox variant-compact-checkbox"><input type="checkbox">Uncertain significance</label><label class="analysis-checkbox variant-compact-checkbox"><input type="checkbox">Likely benign</label><label class="analysis-checkbox variant-compact-checkbox"><input type="checkbox">Benign</label><label class="analysis-checkbox variant-compact-checkbox"><input type="checkbox">Conflicting classifications</label></div></div></details><details class="variant-filter-dropdown"><summary class="variant-filter-dropdown-summary"><span class="variant-filter-dropdown-summary-copy"><span class="variant-filter-dropdown-title">Annotations</span><span class="variant-filter-dropdown-meta">1 active</span></span><span class="variant-filter-dropdown-summary-controls" role="presentation"><label class="variant-summary-select-field"><span>Quick</span><select aria-label="Quick annotations"><option value="all">All</option><option value="high_impact">High impact</option><option value="moderate_to_high">Moderate to high impact</option><option value="all_coding">All coding</option><option value="custom">Custom</option></select></label></span><span class="variant-filter-dropdown-caret" aria-hidden="true">▾</span></summary><div class="variant-filter-dropdown-content"><p class="variant-filter-section-note">A variant is kept when one of its transcripts has any of the ticked consequences or VEP impacts, or reaches the SpliceAI minimum. The transcript filters and the identifiers below must hold on that same transcript.</p><div class="variant-annotation-layout"><div class="variant-annotation-row"><div class="variant-annotation-group" role="group" aria-label="Nonsense"><label class="analysis-checkbox variant-annotation-group-title"><input aria-label="Nonsense (whole group)" type="checkbox">Nonsense</label><div class="variant-annotation-options"><span class="variant-annotation-option"><label class="analysis-checkbox variant-compact-checkbox"><input type="checkbox">Stop gained</label><span class="info-icon" tabindex="0"><span aria-hidden="true">i</span><span class="sr-only">About Stop gained</span></span></span></div></div><div class="variant-annotation-group" role="group" aria-label="Essential splice site"><label class="analysis-checkbox variant-annotation-group-title"><input aria-label="Essential splice site (whole group)" type="checkbox">Essential splice site</label><div class="variant-annotation-options"><span class="variant-annotation-option"><label class="analysis-checkbox variant-compact-checkbox"><input type="checkbox">Splice donor variant</label><span class="info-icon" tabindex="0"><span aria-hidden="true">i</span><span class="sr-only">About Splice donor variant</span></span></span><span class="variant-annotation-option"><label class="analysis-checkbox variant-compact-checkbox"><input type="checkbox">Splice acceptor variant</label><span class="info-icon" tabindex="0"><span aria-hidden="true">i</span><span class="sr-only">About Splice acceptor variant</span></span></span></div></div><div class="variant-annotation-group" role="group" aria-label="Frameshift"><label class="analysis-checkbox variant-annotation-group-title"><input aria-label="Frameshift (whole group)" type="checkbox">Frameshift</label><div class="variant-annotation-options"><span class="variant-annotation-option"><label class="analysis-checkbox variant-compact-checkbox"><input type="checkbox">Frameshift</label><span class="info-icon" tabindex="0"><span aria-hidden="true">i</span><span class="sr-only">About Frameshift</span></span></span></div></div><div class="variant-annotation-group" role="group" aria-label="Missense"><label class="analysis-checkbox variant-annotation-group-title"><input aria-label="Missense (whole group)" type="checkbox">Missense</label><div class="variant-annotation-options"><span class="variant-annotation-option"><label class="analysis-checkbox variant-compact-checkbox"><input type="checkbox">Stop lost</label><span class="info-icon" tabindex="0"><span aria-hidden="true">i</span><span class="sr-only">About Stop lost</span></span></span><span class="variant-annotation-option"><label class="analysis-checkbox variant-compact-checkbox"><input type="checkbox">Start lost</label><span class="info-icon" tabindex="0"><span aria-hidden="true">i</span><span class="sr-only">About Start lost</span></span></span><span class="variant-annotation-option"><label class="analysis-checkbox variant-compact-checkbox"><input type="checkbox">Protein altering</label><span class="info-ic