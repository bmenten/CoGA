nipt-category-option-label">5 — Category 5</span><span class="nipt-category-option-count">0</span></span></label><label class="analysis-checkbox nipt-category-option"><input type="checkbox"><span class="nipt-category-option-copy"><span class="nipt-category-option-label">6 — Category 6</span><span class="nipt-category-option-count">0</span></span></label><label class="analysis-checkbox nipt-category-option"><input type="checkbox"><span class="nipt-category-option-copy"><span class="nipt-category-option-label">7 — Paternal dominant</span><span class="nipt-category-option-count">1</span></span></label><label class="analysis-checkbox nipt-category-option"><input type="checkbox"><span class="nipt-category-option-copy"><span class="nipt-category-option-label">8 — Category 8</span><span class="nipt-category-option-count">0</span></span></label></div><label class="analysis-field-label">Min classification confidence<input min="0" max="1" step="0.05" placeholder="0.00" type="number" value="" name="min_confidence"></label></div></details><details class="variant-filter-dropdown"><summary class="variant-filter-dropdown-summary"><span class="variant-filter-dropdown-summary-copy"><span class="variant-filter-dropdown-title">Pathogenicity</span><span class="variant-filter-dropdown-meta">1 active</span></span><span class="variant-filter-dropdown-summary-controls" role="presentation"><label class="variant-summary-select-field"><span>Quick</span><select aria-label="Quick pathogenicity"><option value="all">All</option><option value="path_likely_path">P/LP</option><option value="not_benign">Not benign</option><option value="custom">Custom</option></select></label></span><span class="variant-filter-dropdown-caret" aria-hidden="true">▾</span></summary><div class="variant-filter-dropdown-content"><p class="variant-annotation-impact-title">ClinVar status</p><div class="variant-checkbox-grid variant-checkbox-grid--small"><label class="analysis-checkbox variant-compact-checkbox"><input type="c