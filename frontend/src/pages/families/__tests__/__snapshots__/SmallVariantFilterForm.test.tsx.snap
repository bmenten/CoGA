nput type="checkbox">tolerated</label></div></div><div><p class="variant-annotation-impact-title">PolyPhen</p><div class="variant-checkbox-grid variant-checkbox-grid--small"><label class="analysis-checkbox variant-compact-checkbox"><input type="checkbox">probably damaging</label><label class="analysis-checkbox variant-compact-checkbox"><input type="checkbox">possibly damaging</label><label class="analysis-checkbox variant-compact-checkbox"><input type="checkbox">benign</label></div></div></div><p class="table-subtle">Variants matching any selected predictor are returned. Numeric thresholds are interpreted as greater-than-or-equal filters.</p></div></details><details class="variant-filter-dropdown"><summary class="variant-filter-dropdown-summary"><span class="variant-filter-dropdown-summary-copy"><span class="variant-filter-dropdown-title">Frequency</span><span class="variant-filter-dropdown-meta">1 active</span></span><span class="variant-filter-dropdown-summary-controls" role="presentation"><label class="variant-summary-select-field"><span>Quick</span><select aria-label="Quick frequency"><option value="all">All</option><option value="gnomad_rare">gnomAD &lt;1%, H/H &lt;=10</option><option value="custom">Custom</option></select></label></span><span class="variant-filter-dropdown-caret" aria-hidden="true">▾</span></summary><div class="variant-filter-dropdown-content"><div class="variant-frequency-slider-grid"><div class="variant-frequency-slider-row"><div class="variant-frequency-slider-header"><span>gnomAD AF</span><span>1%</span></div><input min="0" max="10" step="0.1" type="range" value="1"><button type="button" class="button-secondary variant-frequency-clear">Clear</button></div><div class="variant-frequency-slider-row"><div class="variant-frequency-slider-header"><span>gnomAD popmax AF</span><span>Any</span></div><input min="0" max="10" step="0.1" type="range" value="0"><button type="button" class="button-secondary variant-frequency-clear">Clear</button></div><div class="variant-frequency-slider-row"><div class="variant-frequency-slider-header"><span>gnomAD exomes AF</span><span>Any</span></div><input min="0" max="10" step="0.1" type="range" value="0"><button type="button" class="button-secondary variant-frequency-clear">Clear</button></div><div class="variant-frequency-slider-row"><div class="variant-frequency-slider-header"><span>gnomAD genomes AF</span><span>Any</span></div><input min="0" max="10" step="0.1" type="range" value="0"><button type="button" class="button-secondary variant-frequency-clear">Clear</button></div><div class="variant-frequency-slider-row"><div class="variant-frequency-slider-header"><span>TOPMed AF</span><span>Any</span></div><input min="0" max="10" step="0.1" type="range" value="0"><button type="button" class="button-secondary variant-frequency-clear">Clear</button></div></div><div class="analysis-filter-grid analysis-filter-grid--4"><input placeholder="gnomAD AC ≤" value="" name="max_gnomad_ac"><input placeholder="gnomAD H/H ≤" value="" name="max_gnomad_hom_count"><input placeholder="gnomAD hemi ≤" value="" name="max_gnomad_hemi_count"></div><label class="analysis-checkbox"><input type="checkbox" checked=""><span>ClinVar pathogenic / likely pathogenic overrules the frequency filter</span></label></div></details><details class="variant-filter-dropdown"><summary class="variant-filter-dropdown-summary"><span class="variant-filter-dropdown-summary-copy"><span class="variant-filter-dropdown-title">Locations</span><span class="variant-filter-dropdown-meta">1 active</span></span><span class="variant-filter-dropdown-summary-controls" role="presentation"><label class="variant-summary-select-field"><span>Panel</span><select aria-label="Quick gene panel" name="panel_id"><option value="">Any gene panel</option><option value="panel-1">Mendeliome</option></select></label></span><span class="variant-filter-dropdown-caret" aria-hidden="true">▾</span></summary><div class="variant-filter-dropdown-content"><textarea name="gene" rows="3" placeholder="Gene list: BRCA1
BRCA2
TP53"></textarea></div></details><details class="variant-filter-dropdown"><summary class="variant-filter-dropdown-summary"><span class="variant-filter-dropdown-summary-copy"><span class="variant-filter-dropdown-title">Exclude</span><span class="variant-filter-dropdown-meta">1 active</span></span><span class="variant-filter-dropdown-summary-controls" role="presentation"><label class="variant-summary-select-field"><span>Quick</span><select aria-label="Quick exclude"><option value="all">None</option><option value="benign_likely_benign">Benign/Likely benign</option><option value="custom">Custom</option></select></label></span><span class="variant-filter-dropdown-caret" aria-hidden="true">▾</span></summary><div class="variant-filter-dropdown-content"><p class="variant-annotation-impact-title">Excluded ClinVar status</p><div class="variant-checkbox-grid variant-checkbox-grid--small"><label class="analysis-checkbox variant-compact-checkbox"><input type="checkbox">Pathogenic</label><label class="analysis-checkbox variant-compact-checkbox"><input type="checkbox">Likely pathogenic</label><label class="analysis-checkbox variant-compact-checkbox"><input type="checkbox">Uncertain significance</label><label class="analysis-checkbox variant-compact-checkbox"><input type="checkbox">Likely benign</label><label class="analysis-checkbox variant-compact-checkbox"><input type="checkbox">Benign</label><label class="analysis-checkbox variant-compact-checkbox"><input type="checkbox">Conflicting classifications</label></div></div></details><details class="variant-filter-dropdown"><summary class="variant-filter-dropdown-summary"><span class="variant-filter-dropdown-summary-copy"><span class="variant-filter-dropdown-title">Review and curation</span><span class="variant-filter-dropdown-meta">1 active</span></span><span class="variant-filter-dropdown-summary-controls" role="presentation"><label class="variant-summary-select-field"><span>Quick</span><select aria-label="Quick review"><option value="all">All</option><option value="pathogenic_vus">P/LP/VUS</option><option value="review_tag">Review tag</option><option value="custom">Custom</option></select></label></span><span class="variant-filter-dropdown-caret" aria-hidden="true">▾</span></summary><div class="variant-filter-dropdown-content"><div class="variant-review-curation-columns"><div><p class="variant-annotation-impact-title">Classification</p><div class="variant-checkbox-grid variant-checkbox-grid--small"><label class="analysis-checkbox variant-compact-checkbox"><input type="checkbox">Pathogenic - class 5</label><label class="analysis-checkbox variant-compact-checkbox"><input type="checkbox">Likely Pathogenic - class 4</label><label class="analysis-checkbox variant-compact-checkbox"><input type="checkbox">VUS - class 3</label><label class="analysis-checkbox variant-compact-checkbox"><input type="checkbox">Likely benign - class 2</label><label class="analysis-checkbox variant-compact-checkbox"><input type="checkbox">Benign - class 1</label></div></div><div><p class="variant-annotation-impact-title">Standard tags</p><div class="variant-checkbox-grid variant-checkbox-grid--small"><label class="analysis-checkbox variant-compact-checkbox"><input type="checkbox" checked="">Review</label><label class="analysis-checkbox variant-compact-checkbox"><input type="checkbox">Likely Pathogenic - class 4</label></div></div><div><p class="variant-annotation-impact-title">Custom tags</p><p class="table-subtle">No custom tags available.</p></div></div></div></details></div></section></form>"
