iant-compact-checkbox"><input type="checkbox">missense variant</label><label class="analysis-checkbox variant-compact-checkbox"><input type="checkbox">inframe insertion</label><label class="analysis-checkbox variant-compact-checkbox"><input type="checkbox">inframe deletion</label><label class="analysis-checkbox variant-compact-checkbox"><input type="checkbox">protein altering variant</label></div></div><div class="variant-annotation-impact-group"><label class="analysis-checkbox variant-annotation-impact-title-row"><input type="checkbox"><span class="variant-annotation-impact-title">LOW</span></label><div class="variant-checkbox-grid variant-checkbox-grid--small"><label class="analysis-checkbox variant-compact-checkbox"><input type="checkbox">synonymous variant</label><label class="analysis-checkbox variant-compact-checkbox"><input type="checkbox">splice region variant</label></div></div><div class="variant-annotation-impact-group"><label class="analysis-checkbox variant-annotation-impact-title-row"><input type="checkbox"><span class="variant-annotation-impact-title">MODIFIER</span></label><div class="variant-checkbox-grid variant-checkbox-grid--small"><label class="analysis-checkbox variant-compact-checkbox"><input type="checkbox">coding sequence variant</label><label class="analysis-checkbox variant-compact-checkbox"><input type="checkbox">splice donor 5th base variant</label><label class="analysis-checkbox variant-compact-checkbox"><input type="checkbox">splice donor region variant</label><label class="analysis-checkbox variant-compact-checkbox"><input type="checkbox">splice polypyrimidine tract variant</label><label class="analysis-checkbox variant-compact-checkbox"><input type="checkbox">intron variant</label><label class="analysis-checkbox variant-compact-checkbox"><input type="checkbox">motif feature variant</label><label class="analysis-checkbox variant-compact-checkbox"><input type="checkbox">TF binding site variant</label><label class="analysis-checkbox var