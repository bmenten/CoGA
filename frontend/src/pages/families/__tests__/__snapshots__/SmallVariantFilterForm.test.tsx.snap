ly">About Downstream gene variant</span></span></span><span class="variant-annotation-option"><label class="analysis-checkbox variant-compact-checkbox"><input type="checkbox">NMD transcript variant</label><span class="info-icon" tabindex="0"><span aria-hidden="true">i</span><span class="sr-only">About NMD transcript variant</span></span></span><span class="variant-annotation-option"><label class="analysis-checkbox variant-compact-checkbox"><input type="checkbox">Non-coding transcript exon variant</label><span class="info-icon" tabindex="0"><span aria-hidden="true">i</span><span class="sr-only">About Non-coding transcript exon variant</span></span></span><span class="variant-annotation-option"><label class="analysis-checkbox variant-compact-checkbox"><input type="checkbox">Non-coding transcript variant</label><span class="info-icon" tabindex="0"><span aria-hidden="true">i</span><span class="sr-only">About Non-coding transcript variant</span></span></span><span class="variant-annotation-option"><label class="analysis-checkbox variant-compact-checkbox"><input type="checkbox">Coding transcript variant</label><span class="info-icon" tabindex="0"><span aria-hidden="true">i</span><span class="sr-only">About Coding transcript variant</span></span></span><span class="variant-annotation-option"><label class="analysis-checkbox variant-compact-checkbox"><input type="checkbox">Intergenic variant</label><span class="info-icon" tabindex="0"><span aria-hidden="true">i</span><span class="sr-only">About Intergenic variant</span></span></span><span class="variant-annotation-option"><label class="analysis-checkbox variant-compact-checkbox"><input type="checkbox">Sequence variant</label><span class="info-icon" tabindex="0"><span aria-hidden="true">i</span><span class="sr-only">About Sequence variant</span></span></span></div></div></div><div class="variant-annotation-row"><div class="variant-annotation-group"><label class="variant-annotation-field"><span class="variant-filter-column-title">SpliceAI ≥<span class="info-icon" tabindex="0"><span aria-hidden="true">i</span><span class="sr-only">About SpliceAI ≥</span></span></span><input inputmode="decimal" placeholder="e.g. 0.2" value="" name="min_spliceai"></label></div><div class="variant-annotation-group" role="group" aria-label="Motif feature"><label class="analysis-checkbox variant-annotation-group-title"><input aria-label="Motif feature (whole group)" type="checkbox">Motif feature</label><div class="variant-annotation-options"><span class="variant-annotation-option"><label class="analysis-checkbox variant-compact-checkbox"><input type="checkbox">TFBS ablation</label><span class="info-icon" tabindex="0"><span aria-hidden="true">i</span><span class="sr-only">About TFBS ablation</span></span></span><span class="variant-annotation-option"><label class="analysis-checkbox variant-compact-checkbox"><input type="checkbox">TFBS amplification</label><span class="info-icon" tabindex="0"><span aria-hidden="true">i</span><span class="sr-only">About TFBS amplification</span></span></span><span class="variant-annotation-option"><label class="analysis-checkbox variant-compact-checkbox"><input type="checkbox">TF binding site variant</label><span class="info-icon" tabindex="0"><span aria-hidden="true">i</span><span class="sr-only">About TF binding site variant</span></span></span></div></div><div class="variant-annotation-group" role="group" aria-label="Regulatory feature"><label class="analysis-checkbox variant-annotation-group-title"><input aria-label="Regulatory feature (whole group)" type="checkbox">Regulatory feature</label><div class="variant-annotation-options"><span class="variant-annotation-option"><label class="analysis-checkbox variant-compact-checkbox"><input type="checkbox">Regulatory region variant</label><span class="info-icon" tabindex="0"><span aria-hidden="true">i</span><span class="sr-only">About Regulatory region variant</span></span></span><span class="variant-annotation-option"><label class="analysis-checkbox variant-compact-checkbox"><input type="checkbox">Regulatory region ablation</label><span class="info-icon" tabindex="0"><span aria-hidden="true">i</span><span class="sr-only">About Regulatory region ablation</span></span></span><span class="variant-annotation-option"><label class="analysis-checkbox variant-compact-checkbox"><input type="checkbox">Regulatory region amplification</label><span class="info-icon" tabindex="0"><span aria-hidden="true">i</span><span class="sr-only">About Regulatory region amplification</span></span></span></div></div><div class="variant-annotation-group" role="group" aria-label="VEP impact"><span class="variant-annotation-group-title">VEP impact</span><div class="variant-annotation-options"><span class="variant-annotation-option"><label class="analysis-checkbox variant-compact-checkbox"><input type="checkbox" checked="">HIGH</label><span class="info-icon" tabindex="0"><span aria-hidden="true">i</span><span class="sr-only">About HIGH</span></span></span><span class="variant-annotation-option"><label class="analysis-checkbox variant-compact-checkbox"><input type="checkbox">MODERATE</label><span class="info-icon" tabindex="0"><span aria-hidden="true">i</span><span class="sr-only">About MODERATE</span></span></span><span class="variant-annotation-option"><label class="analysis-checkbox variant-compact-checkbox"><input type="checkbox">LOW</label><span class="info-icon" tabindex="0"><span aria-hidden="true">i</span><span class="sr-only">About LOW</span></span></span><span class="variant-annotation-option"><label class="analysis-checkbox variant-compact-checkbox"><input type="checkbox">MODIFIER</label><span class="info-icon" tabindex="0"><span aria-hidden="true">i</span><span class="sr-only">About MODIFIER</span></span></span></div></div><div class="variant-annotation-group" role="group" aria-label="Transcripts"><span class="variant-annotation-group-title">Transcripts</span><div class="variant-annotation-options"><span class="variant-annotation-option"><label class="analysis-checkbox variant-compact-checkbox"><input type="checkbox">Canonical only</label><span class="info-icon" tabindex="0"><span aria-hidden="true">i</span><span class="sr-only">About Canonical only</span></span></span><span class="variant-annotation-option"><label class="analysis-checkbox variant-compact-checkbox"><input type="checkbox">MANE only</label><span class="info-icon" tabindex="0"><span aria-hidden="true">i</span><span class="sr-only">About MANE only</span></span></span><span class="variant-annotation-option"><label class="analysis-checkbox variant-compact-checkbox"><input type="checkbox">LoF only</label><span class="info-icon" tabindex="0"><span aria-hidden="true">i</span><span class="sr-only">About LoF only</span></span></span></div></div></div></div><div class="analysis-filter-grid analysis-filter-grid--4"><input placeholder="Transcript" value="" name="transcript"><input placeholder="dbSNP / rsID" value="" name="rsid"><input placeholder="HGVS.c" value="" name="hgvsc"><input placeholder="HGVS.p" value="" name="hgvsp"></div></div></details><details class="variant-filter-dropdown"><summary class="variant-filter-dropdown-summary"><span class="variant-filter-dropdown-summary-copy"><span class="variant-filter-dropdown-title">In silico</span><span class="variant-filter-dropdown-meta">1 active</span></span><span class="variant-filter-dropdown-caret" aria-hidden="true">▾</span></summary><div class="variant-filter-dropdown-content"><div class="analysis-filter-grid analysis-filter-grid--5"><input placeholder="CADD ≥" value="20" name="min_cadd"><input placeholder="REVEL ≥" value="" name="min_revel"></div><div class="variant-inline-controls"><div><p class="variant-annotation-impact-title">SIFT</p><div class="variant-checkbox-grid variant-checkbox-grid--small"><label class="analysis-checkbox variant-compact-checkbox"><input type="checkbox">deleterious</label><label class="analysis-checkbox variant-compact-checkbox"><input type="checkbox">deleterious low confidence</label><label class="analysis-checkbox variant-compact-checkbox"><input type="checkbox">tolerated</label></div></div><div><p class="variant-annotation-impact-title">PolyPhen</p><div class="variant-checkbox-grid variant-checkbox-grid--small"><label class="analysis-checkbox variant-compact-checkbox"><input type="checkbox">probably damaging</label><label class="analysis-checkbox variant-compact-checkbox"><input type="checkbox">possibly damaging</label><label class="analysis-checkbox variant-compact-checkbox"><input type="checkbox">benign</label></div></div></div><p class="table-subtle">Variants matching any selected predictor are returned. Numeric thresholds are interpreted as greater-than-or-equal filters. The SpliceAI minimum, set under Annotations, counts as one of these predictors too.</p></div></details><details class="variant-filter-dropdown"><summary class="variant-filter-dropdown-summary"><span class="variant-filter-dropdown-summary-copy"><span class="variant-filter-dropdown-title">Frequency</span><span class="variant-filter-dropdown-meta">1 active</span></span><span class="variant-filter-dropdown-summary-controls" role="presentation"><label class="variant-summary-select-field"><span>AF</span><select aria-label="Maximum AF, all populations"><option value="">Any</option><option value="0">0</option><option value="0.0001">0.0001</option><option value="0.0005">0.0005</option><option value="0.001">0.001</option><option value="0.005">0.005</option><option value="0.01">0.01</option><option value="0.02">0.02</option><option value="0.03">0.03</option><option value="0.04">0.04</option><option value="0.05">0.05</option><option value="0.1">0.1</option></select></label><label class="variant-summary-select-field variant-summary-input-field"><span>AC</span><input aria-label="Maximum gnomAD AC" inputmode="numeric" value="" name="max_gnomad_ac"></label><label class="variant-summary-select-field variant-summary-input-field"><span>H/H</span><input aria-label="Maximum gnomAD homozygotes and hemizygotes" inputmode="numeric" value=""></label></span><span class="variant-filter-dropdown-caret" aria-hidden="true">▾</span></summary><div class="variant-filter-dropdown-content"><p class="variant-filter-section-note">Filter on the allele frequency in each population (AF), and on gnomAD's allele count (AC) and homozygote and hemizygote counts (H/H). A variant a population lacks passes its maximum, as absent from it.</p><div class="variant-frequency-columns"><div class="variant-frequency-column"><span class="variant-filter-column-title">gnomAD genomes<span class="info-icon" tabindex="0"><span aria-hidden="true">i</span><span class="sr-only">About gnomAD genomes</span></span></span><div class="variant-step-slider" style="--slider-position: 1;"><span class="variant-step-slider-value" aria-hidden="true">1</span><input min="0" max="11" step="1" aria-label="gnomAD genomes maximum AF" aria-valuetext="1" type="range" value="11"><span class="variant-step-slider-ends" aria-hidden="true"><span>0</span><span>1</span></span></div></div><div class="variant-frequency-column"><span class="variant-filter-column-title">gnomAD exomes<span class="info-icon" tabindex="0"><span aria-hidden="true">i</span><span class="sr-only">About gnomAD exomes</span></span></span><div class="variant-step-slider" style="--slider-position: 1;"><span class="variant-step-slider-value" aria-hidden="true">1</span><input min="0" max="11" step="1" aria-label="gnomAD exomes maximum AF" aria-valuetext="1" type="range" value="11"><span class="variant-step-slider-ends" aria-hidden="true"><span>0</span><span>1</span></span></div></div><div class="variant-frequency-column"><span class="variant-filter-column-title">Popmax<span class="info-icon" tabindex="0"><span aria-hidden="true">i</span><span class="sr-only">About Popmax</span></span></span><div class="variant-step-slider" style="--slider-position: 1;"><span class="variant-step-slider-value" aria-hidden="true">1</span><input min="0" max="11" step="1" aria-label="Popmax maximum AF" aria-valuetext="1" type="range" value="11"><span class="variant-step-slider-ends" aria-hidden="true"><span>0</span><span>1</span></span></div></div><div class="variant-frequency-column"><span class="variant-filter-column-title">gnomAD combined<span class="info-icon" tabindex="0"><span aria-hidden="true">i</span><span class="sr-only">About gnomAD combined</span></span></span><div class="variant-step-slider" style="--slider-position: 0.45454545454545453;"><span class="variant-step-slider-value" aria-hidden="true">0.01</span><input min="0" max="11" step="1" aria-label="gnomAD combined maximum AF" aria-valuetext="0.01" type="range" value="5"><span class="variant-step-slider-ends" aria-hidden="true"><span>0</span><span>1</span></span></div></div><div class="variant-frequency-column"><span class="variant-filter-column-title">TOPMed<span class="info-icon" tabindex="0"><span aria-hidden="true">i</span><span class="sr-only">About TOPMed</span></span></span><div class="variant-step-slider" style="--slider-position: 1;"><span class="variant-step-slider-value" aria-hidden="true">1</span><input min="0" max="11" step="1" aria-label="TOPMed maximum AF" aria-valuetext="1" type="range" value="11"><span class="variant-step-slider-ends" aria-hidden="true"><span>0</span><span>1</span></span></div></div><div class="variant-frequency-column"><span class="variant-filter-column-title">gnomAD counts<span class="info-icon" tabindex="0"><span aria-hidden="true">i</span><span class="sr-only">About gnomAD counts</span></span></span><div class="variant-frequency-counts"><label class="variant-inline-field"><span>AC ≤</span><input inputmode="numeric" value="" name="max_gnomad_ac"></label><label class="variant-inline-field"><span>Hom ≤</span><input inputmode="numeric" value="" name="max_gnomad_hom_count"></label><label class="variant-inline-field"><span>Hemi ≤</span><input inputmode="numeric" value="" name="max_gnomad_hemi_count"></label></div></div></div><label class="analysis-checkbox"><input type="checkbox" checked=""><span>ClinVar pathogenic / likely pathogenic overrules the frequency filter</span></label></div></details><details class="variant-filter-dropdown"><summary class="variant-filter-dropdown-summary"><span class="variant-filter-dropdown-summary-copy"><span class="variant-filter-dropdown-title">Call quality</span><span class="variant-filter-dropdown-meta">1 active</span></span><span class="variant-filter-dropdown-summary-controls" role="presentation"><label class="variant-summary-select-field"><span>Quality</span><select aria-label="Quick call quality"><option value="all_variants">All variants</option><option value="high_quality">High quality</option><option value="all_passing">Passing</option><option value="custom">Custom</option></select></label></span><span class="variant-filter-dropdown-caret" aria-hidden="true">▾</span></summary><div class="variant-filter-dropdown-content"><p class="variant-filter-section-note">Minimum quality of each member's call: genotype quality (GQ), allele balance (AB, the share of reads with the alternate allele), depth (DP) and alternate-allele reads (AD). Set them here for the members at once, or per member below. Pass variants only keeps a variant when every call that carries it passed its caller's FILTER.</p><div class="variant-quality-columns"><div class="variant-quality-column"><span class="variant-filter-column-title">Affected only<span class="info-icon" tabindex="0"><span aria-hidden="true">i</span><span class="sr-only">About Affected only</span></span></span><label class="variant-switch"><input role="switch" aria-label="Affected only" type="checkbox" checked=""><span class="variant-switch-track" aria-hidden="true"></span></label></div><div class="variant-quality-column" role="radiogroup" aria-label="Filter value"><span class="variant-filter-column-title">Filter value<span class="info-icon" tabindex="0"><span aria-hidden="true">i</span><span class="sr-only">About Filter value</span></span></span><div class="variant-radio-options"><label class="analysis-checkbox"><input type="radio" checked="" name="pass_only">Show all variants</label><label class="analysis-checkbox"><input type="radio" name="pass_only">Pass variants only</label></div></div><div class="variant-quality-column"><span class="variant-filter-column-title">Genotype quality<span class="info-icon" tabindex="0"><span aria-hidden="true">i</span><span class="sr-only">About Genotype quality</span></span></span><div class="variant-step-slider" style="--slider-position: 0.2;"><span class="variant-step-slider-value" aria-hidden="true">20</span><input min="0" max="20" step="1" aria-label="Genotype quality minimum" aria-valuetext="20" type="range" value="4"><span class="variant-step-slider-ends" aria-hidden="true"><span>0</span><span>100</span></span></div></div><div class="variant-quality-column"><span class="variant-filter-column-title">Allele balance<span class="info-icon" tabindex="0"><span aria-hidden="true">i</span><span class="sr-only">About Allele balance</span></span></span><div class="variant-step-slider" style="--slider-position: 0;"><span class="variant-step-slider-value" aria-hidden="true">0%</span><input min="0" max="100" step="1" aria-label="Allele balance minimum" aria-valuetext="0%" type="range" value="0"><span class="variant-step-slider-ends" aria-hidden="true"><span>0%</span><span>100%</span></span></div></div><div class="variant-quality-column"><span class="variant-filter-column-title">Depth<span class="info-icon" tabindex="0"><span aria-hidden="true">i</span><span class="sr-only">About Depth</span></span></span><div class="variant-step-slider" style="--slider-position: 0.2;"><span class="variant-step-slider-value" aria-hidden="true">10</span><input min="0" max="50" step="1" aria-label="Depth minimum" aria-valuetext="10" type="range" value="10"><span class="variant-step-slider-ends" aria-hidden="true"><span>0</span><span>50</span></span></div></div><div class="variant-quality-column"><span class="variant-filter-column-title">Alt reads<span class="info-icon" tabindex="0"><span aria-hidden="true">i</span><span class="sr-only">About Alt reads</span></span></span><div class="variant-step-slider" style="--slider-position: 0;"><span class="variant-step-slider-value" aria-hidden="true">0</span><input min="0" max="20" step="1" aria-label="Alt reads minimum" aria-valuetext="0" type="range" value="0"><span class="variant-step-slider-ends" aria-hidden="true"><span>0</span><span>20</span></span></div></div></div><div class="variant-quality-table-shell"><table class="variant-quality-table"><thead><tr><th scope="col">Member</th><th scope="col">GQ ≥</th><th scope="col">AB ≥</th><th scope="col">DP ≥</th><th scope="col">AD alt ≥</th></tr></thead><tbody><tr><th scope="row"><span class="variant-sample-title">♂ PROBAND</span> <span class="table-chip">proband</span> <span class="table-chip badge-chip--signature">affected</span></th><td><input aria-label="PROBAND GQ ≥" inputmode="decimal" value="20"></td><td><input aria-label="PROBAND AB ≥" inputmode="decimal" value=""></td><td><input aria-label="PROBAND DP ≥" inputmode="decimal" value="10"></td><td><input aria-label="PROBAND AD alt ≥" inputmode="decimal" value=""></td></tr><tr><th scope="row"><span class="variant-sample-title">♀ MOM</span> <span class="table-chip">mother</span> <span class="table-chip ">unaffected</span></th><td><input aria-label="MOM GQ ≥" inputmode="decimal" value=""></td><td><input aria-label="MOM AB ≥" inputmode="decimal" value=""></td><td><input aria-label="MOM DP ≥" inputmode="decimal" value=""></td><td><input aria-label="MOM AD alt ≥" inputmode="decimal" value=""></td></tr><tr><th scope="row"><span class="variant-sample-title">♂ DAD</span> <span class="table-chip">father</span> <span class="table-chip ">unaffected</span></th><td><input aria-label="DAD GQ ≥" inputmode="decimal" value=""></td><td><input aria-label="DAD AB ≥" inputmode="decimal" value=""></td><td><input aria-label="DAD DP ≥" inputmode="decimal" value=""></td><td><input aria-label="DAD AD alt ≥" inputmode="decimal" value=""></td></tr></tbody></table></div></div></details><details class="variant-filter-dropdown"><summary class="variant-filter-dropdown-summary"><span class="variant-filter-dropdown-summary-copy"><span class="variant-filter-dropdown-title">Locations</span><span class="variant-filter-dropdown-meta">1 active</span></span><span class="variant-filter-dropdown-summary-controls" role="presentation"><label class="variant-summary-select-field"><span>Panel</span><select aria-label="Quick gene panel" name="panel_id"><option value="">Any gene panel</option><option value="panel-1">Mendeliome</option></select></label></span><span class="variant-filter-dropdown-caret" aria-hidden="true">▾</span></summary><div class="variant-filter-dropdown-content"><textarea name="gene" rows="3" placeholder="Gene list: BRCA1
