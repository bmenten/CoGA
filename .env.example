APP_ENV=production
# Outside development/test the backend refuses to start unless SECRET_KEY has at least 32
# characters (python -c 'import secrets; print(secrets.token_urlsafe(48))'),
# INTEGRITY_ANCHOR_SIGNING_KEY is the base64 of a 32-byte Ed25519 seed
# (python -c 'import base64, os; print(base64.b64encode(os.urandom(32)).decode())') and not
# the same value as SECRET_KEY, and POSTGRES_PASSWORD, CLICKHOUSE_PASSWORD and ADMIN_PASSWORD
# are set to something other than the change-me placeholders below. Set APP_ENV=development
# for local-only work.
SECRET_KEY=change-me
INTEGRITY_ANCHOR_SIGNING_KEY=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=coga
POSTGRES_USER=coga
POSTGRES_PASSWORD=change-me
# Postgres TLS. POSTGRES_SSLMODE applies to direct DSN connections
# (disable|allow|prefer|require|verify-ca|verify-full). On Cloud SQL, prefer the
# Python Connector for verify-full-grade mTLS over private IP (plain verify-full
# fails the Cloud SQL hostname check). When enabled it supersedes POSTGRES_HOST/SSLMODE.
POSTGRES_SSLMODE=disable
# POSTGRES_USE_CLOUD_SQL_CONNECTOR=false
# POSTGRES_INSTANCE_CONNECTION_NAME=project:region:instance
# CLOUD_SQL_IP_TYPE=PRIVATE
CLICKHOUSE_HOST=localhost
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_DATABASE=coga
# docker compose creates this ClickHouse user with this password. The ClickHouse image
# refuses network logins for the built-in `default` user when it has no password, so
# keep a named user with a password even for local work.
CLICKHOUSE_USER=coga
CLICKHOUSE_PASSWORD=change-me
# TLS to ClickHouse (TF-13 S-2). Plain HTTP locally; production uses HTTPS:
#   CLICKHOUSE_SECURE=true, CLICKHOUSE_HTTP_PORT=8443, CLICKHOUSE_VERIFY=true.
# For a private CA, set CLICKHOUSE_CA_CERT (inline PEM or a file path) so the server
# cert verifies, and CLICKHOUSE_SERVER_HOST_NAME to a DNS SAN in the cert when
# connecting by IP.
CLICKHOUSE_SECURE=false
CLICKHOUSE_VERIFY=true
# CLICKHOUSE_CA_CERT=
# CLICKHOUSE_SERVER_HOST_NAME=
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173","http://localhost:4173","http://127.0.0.1:4173"]
VITE_API_BASE_URL=/api

# Build identity (APP_VERSION / GIT_SHA) is injected at IMAGE-BUILD time via docker
# build-args, NOT here. Do NOT set them in this file: docker-compose `env_file: .env`
# would override the baked-in build identity at runtime and falsify the version frozen
# into signed reports. Without APP_VERSION the image reports the version in VERSION as a
# development build (0.1.0-dev), since only a release build stamps a release's version; to
# stamp the commit too, export GIT_SHA before `docker compose build`:
#   export GIT_SHA="$(git rev-parse --short=12 HEAD)"
# Outside development/test the backend refuses to start without that commit, because every
# report it signs names it.

# The emergency administrator's sign-in.
ADMIN_EMAIL=admin@example.com
# The mail to the administrators about an account that waits for approval (a sign-up, a first
# CAS sign-in): every active administrator gets it, through the mail server SMTP_HOST names, and
# without SMTP_HOST no mail goes out. SMTP_FROM is the sender (ADMIN_EMAIL when unset).
# SMTP_USERNAME signs in to the server, which needs SMTP_STARTTLS=true outside development.
# The Users page shows who gets the mail and sends a test.
# SMTP_HOST=
# SMTP_PORT=25
# SMTP_STARTTLS=false
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# The folders package import may read family package folders from: local folders,
# comma-separated or a JSON list (default /data/families). A package is read where it lies,
# and the genome browser's reads, tracks and QC report are served from it. A bucket is read
# through a folder it is mounted on (on Cloud Run, a read-only Cloud Storage volume:
# docs/deployment-gcp.md); an entry with a scheme (gs://, s3://) stops the backend at start.
FAMILY_IMPORT_ROOTS=/data/families
# Client-IP trust. docker compose: the backend is one hop behind the frontend's /api
# proxy (BACKEND_TRUSTED_PROXY_HOPS, default 1); the frontend is the edge
# (FRONTEND_TRUSTED_PROXY_HOPS, default 0) unless you put a reverse proxy in front of it.
# BACKEND_TRUSTED_PROXY_HOPS=1
# FRONTEND_TRUSTED_PROXY_HOPS=0
# Running the backend without compose, set TRUSTED_PROXY_HOPS directly (default 0).
# TRUSTED_PROXY_HOPS=0
GENE_REFERENCE_CLINGEN_VALIDITY_URL=https://search.clinicalgenome.org/kb/gene-validity/download
GENE_REFERENCE_CLINGEN_DOSAGE_URL=https://search.clinicalgenome.org/kb/gene-dosage/download
GENE_REFERENCE_GENCC_URL=https://search.thegencc.org/download/action/submissions-export-csv
GENE_REFERENCE_CLINVAR_GENE_CONDITION_URL=https://ftp.ncbi.nlm.nih.gov/pub/clinvar/gene_condition_source_id
# HGNC decides which human genes exist and what they used to be called; the gene
# reference sync builds its gene set from this file.
GENE_REFERENCE_HGNC_COMPLETE_SET_URL=https://storage.googleapis.com/public-download-files/hgnc/tsv/tsv/hgnc_complete_set.txt
# Human gene loci come from GENCODE (same release the variant annotation is built on)
# rather than a UCSC track. Pinned by release in the URL; bump both together.
REFERENCE_GENCODE_GTF_URL=https://ftp.ebi.ac.uk/pub/databases/gencode/Gencode_human/release_50/gencode.v50.basic.annotation.gtf.gz
REFERENCE_GENCODE_REFSEQ_METADATA_URL=https://ftp.ebi.ac.uk/pub/databases/gencode/Gencode_human/release_50/gencode.v50.metadata.RefSeq.gz
# T2T-CHM13v2.0 as a second assembly. Off by default: it roughly doubles the reference
# footprint, and its annotation is RefSeq-derived (no biotypes/Ensembl ids/MANE tags).
REFERENCE_BOOTSTRAP_T2T=false
# Reference assemblies CoGA is validated on (comma-separated). A family on any other assembly
# is labelled "not validated for clinical use" and its report cannot be signed out. Extend it
# only through change control, once the assembly is validated (TF-01, TF-06 H12, TF-18).
VALIDATED_ASSEMBLIES=GRCh38
REFERENCE_T2T_GTF_URL=https://hgdownload.soe.ucsc.edu/goldenPath/hs1/bigZips/genes/hs1.ncbiRefSeq.gtf.gz
GENE_REFERENCE_DBNSFP_GENE_PATH=/data/ref-data/dbNSFP5.4_gene.gz
# A start queues the whole-cohort gene reference sync when no gene is cached yet (with or
# without the dbNSFP gene file; without it, it takes hours and leaves dbNSFP's fields empty), and
# again once the file is in place while no cached gene was synced with it.
GENE_REFERENCE_BOOTSTRAP_ON_STARTUP=true
GITHUB_REPOSITORY=bmenten/coga
GITHUB_REPOSITORY_URL=https://github.com/bmenten/coga
GITHUB_RELEASES_URL=https://github.com/bmenten/coga/releases
GITHUB_ISSUES_URL=https://github.com/bmenten/coga/issues/new/choose
GITHUB_API_TOKEN=
GITHUB_REPO_VISIBILITY=private
GITHUB_RELEASE_CACHE_TTL_SECONDS=300
# Microsoft sign-in (Azure AD / Microsoft Entra ID; docs/deployment-gcp.md §12.11).
# With the directory (tenant) ID and the application (client) ID of CoGA's app registration
# (both GUIDs, both or neither: half of them is refused at startup), users sign in with their
# Microsoft account, the first sign-in makes their account (a viewer in no project), and there
# is no sign-up. Left empty, every account signs in with its password.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
# CoGA's API scope; empty is api://<AZURE_CLIENT_ID>/access_as_user.
AZURE_API_SCOPE=
# The emergency (break-glass) sign-in beside Microsoft sign-in: true lets the account
# ADMIN_USERNAME names sign in with its password at /login/emergency, logged and flagged in the
# audit. Keep it false; switch it on only for an emergency (needs AZURE_TENANT_ID).
AZURE_ADMIN_OVERRIDE=false
# Sign-in through the organisation's CAS server instead, such as Ghent University's
# login.ugent.be: the CAS server, and the app's own sign-in page as the service (both or
# neither; not beside AZURE_TENANT_ID). The CAS server must release the user's Entra object ID
# (azureObjectId), the e-mail address and the name to CoGA; a first sign-in makes an account that
# waits for an administrator's approval. AZURE_ADMIN_OVERRIDE works beside it as well.
# CAS_SERVER_URL=https://login.ugent.be
# CAS_SERVICE_URL=https://coga.example.org/login
# CAS_DISPLAY_NAME=UGent
# The names of those attributes in the CAS answer. A sign-in whose answer lacks the e-mail
# address or a name logs the names of the attributes it does carry ("cas sign-in").
# CAS_OBJECT_ID_ATTRIBUTE=azureObjectId
# CAS_EMAIL_ATTRIBUTE=mail
# CAS_GIVEN_NAME_ATTRIBUTE=givenName
# CAS_FAMILY_NAME_ATTRIBUTE=surname

# Optional security / audit tuning
# async (default) or sync. off writes no request audit log and no UI-event log, and is
# refused outside development/test.
AUDIT_LOG_MODE=async
# none = omit query params, keys = log param names only (recommended; captures
# which filters a search used without their values), sanitized = masked values
AUDIT_LOG_QUERY_STRING_MODE=keys

# Advanced backend settings. The values shown are the defaults; uncomment a line to change it.
#
# Browser and sessions. Send HSTS only where TLS terminates in front of the app. The session
# token lifetime is in minutes. CORS_ORIGIN_REGEX (not shown) additionally allows
# http(s)://localhost, 127.0.0.1 and 0.0.0.0 on any port. These local origins are for
# development only: outside development/test the backend refuses to start while
# CORS_ORIGINS or CORS_ORIGIN_REGEX admits the user's own machine or any site. A deployment
# serves the UI from its own origin, so set CORS_ORIGINS to that origin and
# CORS_ORIGIN_REGEX= (empty).
# ENABLE_HSTS=false
# ACCESS_TOKEN_EXPIRE_MINUTES=120
# The bearer token a monitoring scraper sends to GET /metrics (docs/monitoring.md). Unset,
# the endpoint is off. Outside development it needs 32+ characters, distinct from the other
# secrets.
# METRICS_TOKEN=
# Failed-login throttling:
# LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
# LOGIN_RATE_LIMIT_THRESHOLD=5
# LOGIN_RATE_LIMIT_BASE_BACKOFF_SECONDS=30
# LOGIN_RATE_LIMIT_MAX_BACKOFF_SECONDS=900
#
# Postgres schema: false when migrations run out of band and the app uses the restricted
# coga_app role (docs/db-runtime-role-runbook.md). The app then refuses to start unless the
# database is at its own schema revision.
# POSTGRES_RUN_SCHEMA_MIGRATIONS_ON_STARTUP=true
# coga_app's password, for the out-of-band migration (python -m app.db_migrate) only: it
# then enables that role's login. Never set it on the API.
# POSTGRES_APP_PASSWORD=
#
# ClickHouse per-query limits (seconds and bytes; a memory limit of 0 leaves the server's).
# Large gene panels need more than ClickHouse's 256 KiB default query size.
# CLICKHOUSE_MAX_EXECUTION_TIME=110
# CLICKHOUSE_SEND_RECEIVE_TIMEOUT=120
# CLICKHOUSE_MAX_MEMORY_USAGE=0
# CLICKHOUSE_EXTERNAL_SPILL_BYTES=2147483648
# CLICKHOUSE_MAX_QUERY_SIZE=16777216
# The scheduled ClickHouse integrity check (CHECK TABLE sweep):
# CLICKHOUSE_INTEGRITY_MONITOR_ENABLED=true
# CLICKHOUSE_INTEGRITY_INTERVAL_SECONDS=21600
# CLICKHOUSE_INTEGRITY_STARTUP_DELAY_SECONDS=60
#
# Uploads: bytes read from an upload, and the size it may expand to once decompressed.
# MAX_UPLOAD_BYTES=1073741824
# MAX_DECOMPRESSED_UPLOAD_BYTES=2147483648
#
# Audit pipeline. AUDIT_LOG_DROP_ALLOWED=true is refused outside development/test.
# AUDIT_LOG_BATCH_SIZE=50
# AUDIT_LOG_FLUSH_INTERVAL_SECONDS=1.0
# AUDIT_LOG_QUEUE_SIZE=10000
# AUDIT_LOG_DROP_ALLOWED=false
# AUDIT_LOG_BACKPRESSURE_TIMEOUT_SECONDS=5.0
# AUDIT_LOG_MAX_WRITE_ATTEMPTS=3
#
# The gene-info refresh's per-gene NCBI requests: timeouts and retries. The bulk reference
# downloads (HGNC, ClinGen, GENCODE, HPO, ...) keep their own fixed timeouts.
# EXTERNAL_HTTP_CONNECT_TIMEOUT_SECONDS=5.0
# EXTERNAL_HTTP_READ_TIMEOUT_SECONDS=25.0
# EXTERNAL_HTTP_MAX_ATTEMPTS=3
# EXTERNAL_HTTP_BACKOFF_BASE_SECONDS=0.5
# EXTERNAL_HTTP_BACKOFF_MAX_SECONDS=8.0
#
# HPO ontology bootstrap, on a database without HPO terms. The start downloads HPO's newest
# release from its versioned URL and imports it if the file states that release; the terms keep
# the release and the file's SHA-256. When HPO cannot be reached, or the file is refused, or
# HPO_DOWNLOAD_LATEST_ON_STARTUP=false (offline or air-gapped), the start imports the backup: the
# ontology file found (HPO_ONTOLOGY_PATH first), only if its SHA-256 is the vendored file's
# (another file is refused, logged and not imported), or, with no file and the download on, the
# vendored release from its versioned URL under the same check. The backup's release and
# SHA-256 are fixed in the code and change only with the vendored file
# (data/ref-data/hpo/README.md).
# HPO_BOOTSTRAP_ON_STARTUP=true
# HPO_ONTOLOGY_PATH=/data/ref-data/hpo/hp.obo
# HPO_DOWNLOAD_LATEST_ON_STARTUP=true
#
# Reference data loaded on startup. The segmental-duplication file (the repository's copy if
# this one does not exist) is loaded only if it is the shipped
# data/ref-data/clinical_cnv_syndromes_hg38_bundle/ClinGen_recurrent_CNV_V2.1-hg38.bed byte for
# byte; another file is refused, logged and not loaded (docs/data-import.md). That file holds
# GRCh38 coordinates: it is loaded into the assembly REFERENCE_BOOTSTRAP_ASSEMBLY_NAME names
# only when that assembly is GRCh38 (named GRCh38 or hg38, with or without a patch suffix such
# as .p14). For another assembly the start logs a warning and loads nothing; an administrator
# uploads that assembly's own file (Admin → Species & Assemblies).
# A start also builds the clinical CNV knowledgebase, and loads the pinned DGV release
# (DGV_PINNED_RELEASES in backend/app/core/config.py, about 360 MB from dgv.tcag.ca), for a GRCh37
# or GRCh38 assembly that has none yet, each in the background as the Reference page's rebuild and
# load buttons run them. Set either to false to leave it to an administrator.
# A start on a database without Monarch data loads Monarch's newest release (a few MB from
# data.monarchinitiative.org) during the start; false leaves it to Administration → Monarch data.
# REFERENCE_BOOTSTRAP_ENABLED=true
# REFERENCE_BOOTSTRAP_ASSEMBLY_NAME=GRCh38
# REFERENCE_BOOTSTRAP_CLINICAL_CNVS=true
# REFERENCE_BOOTSTRAP_DGV=true
# REFERENCE_BOOTSTRAP_MONARCH=true
# Longest a DGV load may run before it is stopped and marked failed, with nothing loaded.
# DGV_LOAD_TIMEOUT_SECONDS=7200
# REFERENCE_SEGMENTAL_DUPLICATIONS_PATH=/data/ref-data/clinical_cnv_syndromes_hg38_bundle/ClinGen_recurrent_CNV_V2.1-hg38.bed
# CLINICAL_CNV_KB_SCRIPT_PATH=/app/scripts/clinical_cnv_knowledgebase.py
# Longest a clinical CNV knowledgebase rebuild may run before it is stopped and marked failed.
# CLINICAL_CNV_KB_BUILD_TIMEOUT_SECONDS=7200
# PARAPHASE_MEDICAL_REGIONS_PATH=/data/ref-data/paraphase-medical-regions.json
# The STRchive file of the repeat catalogue (the repository's copy if this one does not exist).
# It must be the shipped data/ref-data/STRchive-loci.json byte for byte, or the backend
# refuses to start (docs/data-import.md, "The STRchive release").
# TRGT_STRCHIVE_LOCI_PATH=/data/ref-data/STRchive-loci.json
#
# Family-package import workers, each running one import job at a time (0 to 8): the API's own,
# and each import-worker process's (python -m app.import_worker), which refuses 0. Docker
# Compose gives the API 0 and runs the imports in its import-worker service, so there this is
# the number per import-worker process. A process uses one core, however many workers it runs.
# FAMILY_IMPORT_WORKER_COUNT=1
# Docker Compose: how many import-worker processes run, each on a core of its own. A backfill
# imports this many families at once (times FAMILY_IMPORT_WORKER_COUNT).
# IMPORT_WORKER_REPLICAS=1
# Watched import folders: local folders under FAMILY_IMPORT_ROOTS that the import watcher looks
# into every FAMILY_IMPORT_WATCH_INTERVAL_SECONDS (30 to 86400) for packages a pipeline delivered
# with their package file, coga-package.json (docs/coga-package.md). Each holds a folder per
# project, named as the project, with the package folders in it (<watched folder>/<project>/<package>). It runs
# where the import workers run; one watcher at a time. Empty: no watcher. Local folders only,
# as FAMILY_IMPORT_ROOTS: a mounted bucket is watched through the folder it is mounted on.
# FAMILY_IMPORT_WATCH_ROOTS=/data/families
# FAMILY_IMPORT_WATCH_INTERVAL_SECONDS=300
#
# Frontend server (docker compose passes these to it; docs/security-posture.md). How long the
# /api proxy waits for the backend to start answering, in milliseconds, and the CSP
# connect-src source list (a deployment that knows its hosts narrows it; with Microsoft
# sign-in it must keep https://login.microsoftonline.com, where the browser fetches its tokens).
# API_PROXY_TIMEOUT_MS=600000
# CSP_CONNECT_SRC="'self' https:"
# Optional frontend overrides for external GitHub links
VITE_GITHUB_REPOSITORY_URL=https://github.com/bmenten/coga
VITE_GITHUB_RELEASES_URL=https://github.com/bmenten/coga/releases
VITE_GITHUB_ISSUES_URL=https://github.com/bmenten/coga/issues/new/choose
# Where users report a problem or request a change: the CMGGMC probleemmelding route (TF-16,
# TF-17), as an https:// or mailto: address. Baked in at image-build time, like the links
# above. Set it for every clinical build: without it a production build shows no
# problem-report link (a development build falls back to VITE_GITHUB_ISSUES_URL). Clinical
# problems and incidents never go to the public GitHub issue form (SECURITY.md).
VITE_PROBLEM_REPORT_URL=

# Optional override of the bundled public reference of the exploratory ancestry PCA (outside
# the intended purpose; docs/ancestry-pca.md): an .npz with its .json checksum/provenance
# sidecar. Empty uses the bundled, pinned model. Nothing is downloaded or sent at runtime.
ANCESTRY_REFERENCE_PATH=
