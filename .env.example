APP_ENV=production
# Outside development/test the backend refuses to start unless SECRET_KEY has at least 32
# characters (python -c 'import secrets; print(secrets.token_urlsafe(48))'),
# INTEGRITY_ANCHOR_SIGNING_KEY is the base64 of a 32-byte Ed25519 seed
# (python -c 'import base64, os; print(base64.b64encode(os.urandom(32)).decode())') and not
# the same value as SECRET_KEY, and POSTGRES_PASSWORD, CLICKHOUSE_PASSWORD and ADMIN_PASSWORD
# are set to something other than the change-me placeholders below. Set APP_ENV=development
# for local-only work.
SECRET_KEY=change-me
INTEGRITY_ANCHOR_SIGNING_KEY=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=coga
POSTGRES_USER=coga
POSTGRES_PASSWORD=change-me
# Postgres TLS. POSTGRES_SSLMODE applies to direct DSN connections
# (disable|allow|prefer|require|verify-ca|verify-full). On Cloud SQL, prefer the
# Python Connector for verify-full-grade mTLS over private IP (plain verify-full
# fails the Cloud SQL hostname check). When enabled it supersedes POSTGRES_HOST/SSLMODE.
POSTGRES_SSLMODE=disable
# POSTGRES_USE_CLOUD_SQL_CONNECTOR=false
# POSTGRES_INSTANCE_CONNECTION_NAME=project:region:instance
# CLOUD_SQL_IP_TYPE=PRIVATE
CLICKHOUSE_HOST=localhost
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_DATABASE=coga
# docker compose creates this ClickHouse user with this password. The ClickHouse image
# refuses network logins for the built-in `default` user when it has no password, so
# keep a named user with a password even for local work.
CLICKHOUSE_USER=coga
CLICKHOUSE_PASSWORD=change-me
# TLS to ClickHouse (TF-13 S-2). Plain HTTP locally; production uses HTTPS:
#   CLICKHOUSE_SECURE=true, CLICKHOUSE_HTTP_PORT=8443, CLICKHOUSE_VERIFY=true.
# For a private CA, set CLICKHOUSE_CA_CERT (inline PEM or a file path) so the server
# cert verifies, and CLICKHOUSE_SERVER_HOST_NAME to a DNS SAN in the cert when
# connecting by IP.
CLICKHOUSE_SECURE=false
CLICKHOUSE_VERIFY=true
# CLICKHOUSE_CA_CERT=
# CLICKHOUSE_SERVER_HOST_NAME=
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173","http://localhost:4173","http://127.0.0.1:4173"]
VITE_API_BASE_URL=/api

# Build identity (APP_VERSION / GIT_SHA) is injected at IMAGE-BUILD time via docker
# build-args, NOT here. Do NOT set them in this file: docker-compose `env_file: .env`
# would override the baked-in build identity at runtime and falsify the version frozen
# into signed reports. To stamp a build, export them before `docker compose build`:
#   export APP_VERSION="$(cat VERSION)" GIT_SHA="$(git rev-parse --short=12 HEAD)"

# Optional backend settings. A new signup is announced to ADMIN_EMAIL through the SMTP relay
# at SMTP_HOST (port 25, no authentication), only when ADMIN_EMAIL is set.
ADMIN_EMAIL=admin@example.com
# SMTP_HOST=localhost
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Object-storage backend for raw family data (IGV alignments + family-package
# sources): local (default), s3, or gcs.
#   s3:  set S3_BUCKET (+ optional S3_REGION/S3_PREFIX/S3_ENDPOINT_URL).
#   gcs: set GCS_BUCKET (+ optional GCS_PREFIX). Credentials come from Application
#        Default Credentials (Workload Identity on Cloud Run); signed URLs use IAM
#        SignBlob, so the runtime service account needs
#        roles/iam.serviceAccountTokenCreator on itself and the IAM Credentials API.
STORAGE_BACKEND=local
# S3_BUCKET=
# GCS_BUCKET=
# GCS_PREFIX=
# GCS_ENDPOINT_URL= (override for a GCS-compatible endpoint, e.g. fake-gcs-server in tests)
# GCS_PROJECT= (optional; mainly for emulators)
# Roots that Package Import scans for family folders. Local default is
# /data/families; cloud/Terraform deployments point this at a bucket, e.g.
# FAMILY_IMPORT_ROOTS=gs://my-coga-bucket/families  (or s3://...; comma-separate multiple).
FAMILY_IMPORT_ROOTS=/data/families
# Client-IP trust (#520). docker compose: the backend is one hop behind the frontend's /api
# proxy (BACKEND_TRUSTED_PROXY_HOPS, default 1); the frontend is the edge
# (FRONTEND_TRUSTED_PROXY_HOPS, default 0) unless you put a reverse proxy in front of it.
# BACKEND_TRUSTED_PROXY_HOPS=1
# FRONTEND_TRUSTED_PROXY_HOPS=0
# Running the backend without compose, set TRUSTED_PROXY_HOPS directly (default 0).
GENE_REFERENCE_CLINGEN_VALIDITY_URL=https://search.clinicalgenome.org/kb/gene-validity/download
GENE_REFERENCE_CLINGEN_DOSAGE_URL=https://search.clinicalgenome.org/kb/gene-dosage/download
GENE_REFERENCE_GENCC_URL=https://search.thegencc.org/download/action/submissions-export-csv
GENE_REFERENCE_CLINVAR_GENE_CONDITION_URL=https://ftp.ncbi.nlm.nih.gov/pub/clinvar/gene_condition_source_id
# HGNC decides which human genes exist and what they used to be called; the gene
# reference sync builds its gene set from this file.
GENE_REFERENCE_HGNC_COMPLETE_SET_URL=https://storage.googleapis.com/public-download-files/hgnc/tsv/tsv/hgnc_complete_set.txt
# Human gene loci come from GENCODE (same release the variant annotation is built on)
# rather than a UCSC track. Pinned by release in the URL; bump both together.
REFERENCE_GENCODE_GTF_URL=https://ftp.ebi.ac.uk/pub/databases/gencode/Gencode_human/release_50/gencode.v50.basic.annotation.gtf.gz
REFERENCE_GENCODE_REFSEQ_METADATA_URL=https://ftp.ebi.ac.uk/pub/databases/gencode/Gencode_human/release_50/gencode.v50.metadata.RefSeq.gz
# T2T-CHM13v2.0 as a second assembly. Off by default: it roughly doubles the reference
# footprint, and its annotation is RefSeq-derived (no biotypes/Ensembl ids/MANE tags).
REFERENCE_BOOTSTRAP_T2T=false
# Reference assemblies CoGA is validated on (comma-separated). A family on any other assembly
# is labelled "not validated for clinical use" and its report cannot be signed out. Extend it
# only through change control, once the assembly is validated (TF-01, TF-06 H12, TF-18).
VALIDATED_ASSEMBLIES=GRCh38
REFERENCE_T2T_GTF_URL=https://hgdownload.soe.ucsc.edu/goldenPath/hs1/bigZips/genes/hs1.ncbiRefSeq.gtf.gz
GENE_REFERENCE_DBNSFP_GENE_PATH=/data/ref-data/dbNSFP5.4_gene.gz
GENE_REFERENCE_BOOTSTRAP_ON_STARTUP=true
GITHUB_REPOSITORY=bmenten/coga
GITHUB_REPOSITORY_URL=https://github.com/bmenten/coga
GITHUB_RELEASES_URL=https://github.com/bmenten/coga/releases
GITHUB_ISSUES_URL=https://github.com/bmenten/coga/issues/new/choose
GITHUB_API_TOKEN=
GITHUB_REPO_VISIBILITY=private
GITHUB_RELEASE_CACHE_TTL_SECONDS=300
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_ADMIN_OVERRIDE=false

# Optional security / audit tuning
# async (default) or sync. off writes no request audit log and no UI-event log, and is
# refused outside development/test.
AUDIT_LOG_MODE=async
# none = omit query params, keys = log param names only (recommended; captures
# which filters a search used without their values), sanitized = masked values
AUDIT_LOG_QUERY_STRING_MODE=keys

# Advanced backend settings. The values shown are the defaults; uncomment a line to change it.
#
# Browser and sessions. Send HSTS only where TLS terminates in front of the app. The session
# token lifetime is in minutes. CORS_ORIGIN_REGEX (not shown) additionally allows
# http(s)://localhost, 127.0.0.1 and 0.0.0.0 on any port.
# ENABLE_HSTS=false
# ACCESS_TOKEN_EXPIRE_MINUTES=120
# Failed-login throttling:
# LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
# LOGIN_RATE_LIMIT_THRESHOLD=5
# LOGIN_RATE_LIMIT_BASE_BACKOFF_SECONDS=30
# LOGIN_RATE_LIMIT_MAX_BACKOFF_SECONDS=900
#
# Postgres schema: false when migrations run out of band and the app uses the restricted
# coga_app role (docs/db-runtime-role-runbook.md).
# POSTGRES_RUN_SCHEMA_MIGRATIONS_ON_STARTUP=true
# coga_app's password, for the out-of-band migration (python -m app.db_migrate) only: it
# then enables that role's login. Never set it on the API.
# POSTGRES_APP_PASSWORD=
#
# ClickHouse per-query limits (seconds and bytes; a memory limit of 0 leaves the server's).
# Large gene panels need more than ClickHouse's 256 KiB default query size.
# CLICKHOUSE_MAX_EXECUTION_TIME=110
# CLICKHOUSE_SEND_RECEIVE_TIMEOUT=120
# CLICKHOUSE_MAX_MEMORY_USAGE=0
# CLICKHOUSE_EXTERNAL_SPILL_BYTES=2147483648
# CLICKHOUSE_MAX_QUERY_SIZE=16777216
# The scheduled ClickHouse integrity check (CHECK TABLE sweep):
# CLICKHOUSE_INTEGRITY_MONITOR_ENABLED=true
# CLICKHOUSE_INTEGRITY_INTERVAL_SECONDS=21600
# CLICKHOUSE_INTEGRITY_STARTUP_DELAY_SECONDS=60
#
# Uploads: bytes read from an upload, and the size it may expand to once decompressed.
# MAX_UPLOAD_BYTES=1073741824
# MAX_DECOMPRESSED_UPLOAD_BYTES=2147483648
#
# Audit pipeline. AUDIT_LOG_DROP_ALLOWED=true is refused outside development/test.
# AUDIT_LOG_BATCH_SIZE=50
# AUDIT_LOG_FLUSH_INTERVAL_SECONDS=1.0
# AUDIT_LOG_QUEUE_SIZE=10000
# AUDIT_LOG_DROP_ALLOWED=false
# AUDIT_LOG_BACKPRESSURE_TIMEOUT_SECONDS=5.0
# AUDIT_LOG_MAX_WRITE_ATTEMPTS=3
#
# Outbound requests to reference sources (HGNC, ClinGen, NCBI, ...): timeouts and retries.
# EXTERNAL_HTTP_CONNECT_TIMEOUT_SECONDS=5.0
# EXTERNAL_HTTP_READ_TIMEOUT_SECONDS=25.0
# EXTERNAL_HTTP_MAX_ATTEMPTS=3
# EXTERNAL_HTTP_BACKOFF_BASE_SECONDS=0.5
# EXTERNAL_HTTP_BACKOFF_MAX_SECONDS=8.0
#
# HPO ontology bootstrap. The URL must be HTTPS; set HPO_ONTOLOGY_SHA256 (hex) to pin the
# download, otherwise its digest is logged.
# HPO_BOOTSTRAP_ON_STARTUP=true
# HPO_ONTOLOGY_PATH=/data/ref-data/hpo/hp.obo
# HPO_ONTOLOGY_URL=https://purl.obolibrary.org/obo/hp.obo
# HPO_ONTOLOGY_SHA256=
# HPO_DOWNLOAD_IF_MISSING=true
#
# Reference data loaded on startup.
# REFERENCE_BOOTSTRAP_ENABLED=true
# REFERENCE_BOOTSTRAP_ASSEMBLY_NAME=GRCh38
# REFERENCE_CLINICAL_CNVS_PATH=/data/ref-data/clinical_cnv_syndromes_hg38_combined.tsv
# REFERENCE_SEGMENTAL_DUPLICATIONS_PATH=/data/ref-data/clinical_cnv_syndromes_hg38_bundle/ClinGen_recurrent_CNV_V2.1-hg38.bed
# CLINICAL_CNV_KB_SCRIPT_PATH=/app/scripts/clinical_cnv_knowledgebase.py
# Longest a clinical CNV knowledgebase rebuild may run before it is stopped and marked failed.
# CLINICAL_CNV_KB_BUILD_TIMEOUT_SECONDS=7200
# PARAPHASE_MEDICAL_REGIONS_PATH=/data/ref-data/paraphase-medical-regions.json
# TRGT_STRCHIVE_LOCI_PATH=/data/ref-data/STRchive-loci.json
#
# Family-package import workers (1 to 8).
# FAMILY_IMPORT_WORKER_COUNT=1
#
# S3 object storage (STORAGE_BACKEND=s3). S3_ENDPOINT_URL is for an S3-compatible store such
# as MinIO. The presign expiry also applies to GCS signed URLs.
# S3_REGION=
# S3_ENDPOINT_URL=
# S3_PREFIX=
# S3_PRESIGN_EXPIRY_SECONDS=3600
# S3_CONNECT_TIMEOUT_SECONDS=5.0
# S3_READ_TIMEOUT_SECONDS=60.0
# S3_MAX_ATTEMPTS=5
# Optional frontend overrides for external GitHub links
VITE_GITHUB_REPOSITORY_URL=https://github.com/bmenten/coga
VITE_GITHUB_RELEASES_URL=https://github.com/bmenten/coga/releases
VITE_GITHUB_ISSUES_URL=https://github.com/bmenten/coga/issues/new/choose
# Where users report a problem or request a change: the CMGGMC probleemmelding route (TF-16,
# TF-17), as an https:// or mailto: address. Baked in at image-build time, like the links
# above. Set it for every clinical build: without it a production build shows no
# problem-report link (a development build falls back to VITE_GITHUB_ISSUES_URL). Clinical
# problems and incidents never go to the public GitHub issue form (SECURITY.md).
VITE_PROBLEM_REPORT_URL=
